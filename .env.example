# ---------------------------------------------------------------------------
# Collector worker (worker/bridge_worker.py) - backend only.
# Use the service_role key here; never add a NEXT_PUBLIC_ prefix and never put
# this key in Vercel or in a browser-facing environment.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Web app (web/) - set these in the hosting provider (Vercel project settings).
# The API routes read them server-side; they are never exposed to the browser.
# Get the anon key from Supabase Dashboard -> Project Settings -> API.
#
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_ANON_KEY=your-anon-public-key
#
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY still work as
# fallbacks for an existing deployment. See docs/HOSTED_DEPLOYMENT.md.
# ---------------------------------------------------------------------------
